# Vercel → Project → Settings → Environment Variables
#
# The single origin of your Oracle Cloud control plane. Server-side only: it is
# read by Next route handlers and never shipped to the browser, so it must NOT be
# prefixed with NEXT_PUBLIC_.
#
# Must be https — the dashboard is served over TLS and a browser will refuse to
# open a plaintext WebSocket from it.
MERIDIAN_API_URL=https://api.your-host.example

# Optional but recommended. The same random value as MERIDIAN_RELAY_SECRET in
# /etc/meridian/meridian.env on the VM. With it, the control plane locks out the
# address actually guessing passwords; without it, every sign-in arrives from
# Vercel's servers and one bot's wrong guesses lock the operator out too.
# Server-side only — never prefix with NEXT_PUBLIC_.
MERIDIAN_RELAY_SECRET=
