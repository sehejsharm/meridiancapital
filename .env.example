# ============================================================
#  MERIDIAN CAPITAL — environment configuration
#  Copy to .env and fill in.  NEVER commit .env.
# ============================================================

# ---- Angel One SmartAPI credentials ----
# Get these from https://smartapi.angelbroking.com/
# TOTP_SECRET is the base32 seed shown when you enable TOTP.
ANGEL_API_KEY=
ANGEL_SECRET_KEY=
ANGEL_CLIENT_ID=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=

# ---- Trading mode ----
# PAPER_MODE=true  -> simulated fills at real LTP +/- slippage. No real orders.
# PAPER_MODE=false -> REAL MONEY. Real orders hit the exchange.
PAPER_MODE=true
SEED_CAPITAL=20000
PAPER_SLIPPAGE_PCT=0.005

# ---- Schedule (24h, Asia/Kolkata) ----
# The supervisor boots the bot at START and hard-stops it at STOP.
# The algorithm itself force-closes positions at 15:00 and files its
# EOD report at 15:30; the 15:45 stop is the outer backstop.
SESSION_START=09:15
SESSION_STOP=15:45
TZ=Asia/Kolkata

# Run the schedule automatically. Set false to only start/stop by hand.
AUTO_SCHEDULE=true

# Skip NSE trading holidays listed in backend/app/holidays.py
SKIP_HOLIDAYS=true

# ---- Login ----
# What you type into the app. The password is hashed with scrypt at boot and
# never stored in plaintext outside this file.
ADMIN_USER=Sehej
ADMIN_PASSWORD=

# Optional: supply a pre-computed hash instead of the plaintext above.
#   python3 -c "import sys;sys.path.insert(0,'backend');from app.auth import hash_password;print(hash_password('yourpassword'))"
ADMIN_PASSWORD_HASH=

# ---- API token ----
# For curl, scripted exports and anything non-interactive. Optional if you
# only ever sign in through the app.
# Generate one:  python3 -c "import secrets;print(secrets.token_urlsafe(32))"
API_TOKEN=

# ---- Server ----
HOST=0.0.0.0
PORT=8000
DATA_DIR=./data

# ---- Push notifications (optional) ----
# Expo push token from the mobile app's Settings screen.
# Leave blank to disable push.
EXPO_PUSH_TOKEN=
PUSH_ON_ENTRY=true
PUSH_ON_EXIT=true
PUSH_ON_EOD=true
PUSH_ON_KILL=true
