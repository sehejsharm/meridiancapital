# /etc/meridian/meridian.env — owned by root, mode 0640, group meridian.
# chmod 640 /etc/meridian/meridian.env && chown root:meridian /etc/meridian/meridian.env
#
# This file is the ONLY place broker credentials exist. Never commit a filled-in
# copy, never paste it into a chat, and rotate everything in it if you ever do.

# ── Angel One SmartAPI ────────────────────────────────────────────────────────
# From https://smartapi.angelbroking.com — create an app to get the API key.
# ANGEL_PASSWORD is the account PIN. ANGEL_TOTP_SECRET is the base32 seed shown
# when you enable TOTP; anyone holding it can generate your 2FA codes, so treat
# it exactly like the password.
ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=

# Angel only accepts orders from the static IP whitelisted for your SmartAPI app
# (smartapi.angelone.in -> My Apps -> edit app); anything else is rejected with
# AG7002, exits included. Set this to the VM's public IP once it is whitelisted,
# and a live engine refuses to start if its traffic leaves from anywhere else.
# Empty: the IP is discovered and logged, but not checked. Find it with
#   curl -s https://api.ipify.org
ANGEL_PUBLIC_IP=
ANGEL_LOCAL_IP=127.0.0.1
ANGEL_MAC_ADDR=00:00:00:00:00:00

# ── Dashboard authentication ──────────────────────────────────────────────────
# Generate both with:  .venv/bin/python scripts/bootstrap_secrets.py
MERIDIAN_PASSWORD_HASH=
MERIDIAN_JWT_SECRET=
# Shared with the dashboard (same value in Vercel) so sign-in lockouts land on
# the real visitor rather than on Vercel's servers. Generate with:
#   openssl rand -hex 32
# Leave empty to disable; the lockout then keys on the connecting address.
MERIDIAN_RELAY_SECRET=
MERIDIAN_OPERATOR=sehej
MERIDIAN_TOKEN_TTL_MIN=720

# ── Network ───────────────────────────────────────────────────────────────────
# Your Vercel dashboard origin. Comma-separated if you use preview deployments.
MERIDIAN_CORS_ORIGINS=https://meridian.vercel.app

# ── Engine ────────────────────────────────────────────────────────────────────
# Start in paper. Switch to live from the dashboard once a full session has run
# clean: the dashboard requires a typed confirmation, this file does not.
MERIDIAN_TRADING_MODE=paper

# Arm the automatic start/stop around the NSE session.
MERIDIAN_AUTOSTART=1

# Crash-restart policy for one session. After this many restarts the scheduler
# stops trying and waits for you, rather than looping into a broken broker.
MERIDIAN_MAX_RESTARTS=5
MERIDIAN_RESTART_BACKOFF_SEC=30

# Where the database, state file and scrip cache live.
MERIDIAN_DATA_DIR=/var/lib/meridian

# ── alerts (optional) ────────────────────────────────────────────────────────
# Trade entered/exited, any kill switch, engine crash or crash loop, automation
# armed/disarmed, NSE holiday ahead. Nothing is sent unless one is set.
# Telegram: create a bot with @BotFather, message it once, then read your chat id
# from https://api.telegram.org/bot<token>/getUpdates.
MERIDIAN_TELEGRAM_BOT_TOKEN=
MERIDIAN_TELEGRAM_CHAT_ID=
# Any JSON webhook ({"title","text","kind","level","ts"}): a WhatsApp or email
# bridge (Make, Zapier, n8n, Twilio) takes it from there.
MERIDIAN_ALERT_WEBHOOK=

# ── outside heartbeat (optional, strongly advised) ───────────────────────────
# The one failure the desk cannot report about itself is the VM or the API being
# down. Create a check at a "tell me when the pings stop" service (healthchecks.io
# is free: period 1 minute, grace 1 minute, alert by email, Telegram or phone),
# and paste its ping address here. The API fetches it once a minute; when the
# pings stop, the service tells you within two minutes. https:// only.
MERIDIAN_HEARTBEAT_URL=

# ── after-close check ────────────────────────────────────────────────────────
# From 15:35 on every trading day, once nothing is running, the API logs in to
# Angel with the ANGEL_* values above, reads the position book and the trade
# book (read-only), compares them with what the desk recorded, and keeps the
# day's one-minute option prices for research. It needs the four ANGEL_* values
# to be filled in here; without them only the desk's own records are checked.
# Set to 0 to never log in to Angel from the API.
MERIDIAN_AFTER_CLOSE_ANGEL=1

# ── journal retention ────────────────────────────────────────────────────────
# Journal lines older than this many days are archived to
# /var/lib/meridian/archive/journal-YYYY-MM.jsonl.gz and then removed (never
# fewer than 90). Trades, and so every report and tax figure, are never removed.
MERIDIAN_JOURNAL_KEEP_DAYS=365

# ── backups off the machine ──────────────────────────────────────────────────
# The nightly backup (22:30 IST) stays on this VM unless one of these is set; a
# backup on the same machine does not survive losing the machine.
#   MERIDIAN_BACKUP_URL     an HTTPS upload address ending in "/". An Oracle
#                           Object Storage pre-authenticated request (bucket ->
#                           Pre-Authenticated Requests -> permit object writes
#                           and reads) is free and needs no other credentials.
#   MERIDIAN_BACKUP_REMOTE  an scp target, user@host:/path/ (root's SSH key).
#   MERIDIAN_BACKUP_PASSPHRASE  encrypts the copy that leaves (AES-256). Required
#                           for MERIDIAN_BACKUP_URL: the database holds your
#                           programs' source. Keep a copy of it somewhere that
#                           is not this VM — without it the copy cannot be read.
# On the 1st of each month the newest backup is restored to a scratch folder and
# checked (deploy/restore-test.sh); the Reliability page shows the result.
MERIDIAN_BACKUP_URL=
MERIDIAN_BACKUP_REMOTE=
MERIDIAN_BACKUP_PASSPHRASE=

# ── staging ──────────────────────────────────────────────────────────────────
# 1 on a staging copy of the desk (a second VM set up with install.sh --staging):
# everything works and real money is refused. Never set it on the VM that trades.
MERIDIAN_STAGING=0
