# /etc/meridian/meridian.env — owned by root, mode 0640, group meridian.
# chmod 640 /etc/meridian/meridian.env && chown root:meridian /etc/meridian/meridian.env
#
# This file is the ONLY place broker credentials exist. Never commit a filled-in
# copy, never paste it into a chat, and rotate everything in it if you ever do.

# ── Angel One SmartAPI ────────────────────────────────────────────────────────
# From https://smartapi.angelbroking.com — create an app to get the API key.
# ANGEL_PASSWORD is the account PIN. ANGEL_TOTP_SECRET is the base32 seed shown
# when you enable TOTP; anyone holding it can generate your 2FA codes, so treat
# it exactly like the password.
ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=

# Angel's session headers want the VM's identity. Leave ANGEL_PUBLIC_IP empty to
# discover it at login (correct after an Oracle reboot changes the address).
ANGEL_PUBLIC_IP=
ANGEL_LOCAL_IP=127.0.0.1
ANGEL_MAC_ADDR=00:00:00:00:00:00

# ── Dashboard authentication ──────────────────────────────────────────────────
# Generate both with:  .venv/bin/python scripts/bootstrap_secrets.py
MERIDIAN_PASSWORD_HASH=
MERIDIAN_JWT_SECRET=
# Shared with the dashboard (same value in Vercel) so sign-in lockouts land on
# the real visitor rather than on Vercel's servers. Generate with:
#   openssl rand -hex 32
# Leave empty to disable; the lockout then keys on the connecting address.
MERIDIAN_RELAY_SECRET=
MERIDIAN_OPERATOR=sehej
MERIDIAN_TOKEN_TTL_MIN=720

# ── Network ───────────────────────────────────────────────────────────────────
# Your Vercel dashboard origin. Comma-separated if you use preview deployments.
MERIDIAN_CORS_ORIGINS=https://meridian.vercel.app
MERIDIAN_BIND_HOST=127.0.0.1
MERIDIAN_BIND_PORT=8080

# ── Engine ────────────────────────────────────────────────────────────────────
# Start in paper. Switch to live from the dashboard once a full session has run
# clean: the dashboard requires a typed confirmation, this file does not.
MERIDIAN_TRADING_MODE=paper

# Arm the automatic start/stop around the NSE session.
MERIDIAN_AUTOSTART=1

# Crash-restart policy for one session. After this many restarts the scheduler
# stops trying and waits for you, rather than looping into a broken broker.
MERIDIAN_MAX_RESTARTS=5
MERIDIAN_RESTART_BACKOFF_SEC=30

# Where the database, state file and scrip cache live.
MERIDIAN_DATA_DIR=/var/lib/meridian
